# Copy this file to .env on the OVH server and set chmod 600.
# Never commit the resulting .env.

# Absolute paths on the server.
COLLECTOR_REPO_PATH=/opt/rieltor/repos/collector
CLEANER_REPO_PATH=/opt/rieltor/repos/cleaner
MAIN_REPO_PATH=/opt/rieltor/repos/main
DATA_ROOT=/srv/rieltor

# Generate independently, for example: openssl rand -base64 48
COLLECTOR_API_KEY=CHANGE_ME
CLEANER_API_KEY=CHANGE_ME

# Live OpenAI key. Do not paste it into compose.yaml or GitHub.
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-6-luna
REASONING_EFFORT=medium

# Safe migration defaults. Keep these values for the first OVH start.
COLLECTOR_PAUSED=1
MIN_BATCH_SIZE=999999
PILOT_LIMIT=0

# Runtime cadence.
CLEANER_CYCLE_INTERVAL_H=12
CLEANER_INGEST_TICK_S=300
CLEANER_FULL_RETRY_S=900
MAX_BATCH_SIZE=3000
MAX_BATCHES_PER_CYCLE=10
MAX_LLM_ATTEMPTS=3
ENTITY_SHADOW_ENABLED=1
ENTITY_MANUAL_WRITES_ENABLED=0
LOG_LEVEL=INFO

# Localhost-only admin ports. Reach them through an SSH tunnel.
COLLECTOR_HOST_PORT=8001
CLEANER_HOST_PORT=8002

# Conservative limits for an OVH VPS-3 (6 vCPU / 12 GB RAM).
COLLECTOR_MEMORY_LIMIT=3g
COLLECTOR_CPU_LIMIT=2.5
CLEANER_MEMORY_LIMIT=3g
CLEANER_CPU_LIMIT=2.0
MAIN_MEMORY_LIMIT=3g
MAIN_CPU_LIMIT=2.0

# Purchase Main is disabled by default in compose.yaml. These values are used
# only after: docker compose --profile purchase-main up -d main
MAIN_OPENAI_MODEL=gpt-5-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COLLECTOR_START_FROM=end
COLLECTOR_POLL_INTERVAL_SEC=60
